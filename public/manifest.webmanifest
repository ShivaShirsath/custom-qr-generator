{
  "name": "Hi there, QR!",
  "short_name": "Hi there, QR!",
  "description": "Free, open-source QR code generator with styles, logos and frames. Works offline.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#efeaff",
  "theme_color": "#8b6cf0",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "scope": "/",
  "orientation": "any",
  "lang": "en",
  "categories": ["utilities", "productivity", "design"]
}
