# Custom QR Generator: server environment variables.
# Copy to .env.local for `vercel dev`, or set them in the Vercel project settings.
# Every variable is optional; invalid values fall back to the defaults shown.

# --- Rate limiting (Vercel Routing Middleware, middleware.ts) -------------------

# Set to false to turn rate limiting off entirely.
RATE_LIMIT_ENABLED=true

# API bucket (/api/*): max requests per IP per window.
RATE_LIMIT_API_MAX=30
RATE_LIMIT_API_WINDOW_SECONDS=60

# Page bucket (HTML page loads; static assets are never limited).
RATE_LIMIT_PAGE_MAX=120
RATE_LIMIT_PAGE_WINDOW_SECONDS=60

# --- Shared store (recommended in production) ------------------------------------
# With Upstash Redis set, limits are shared across all instances and regions
# (sliding window). Without it, each instance keeps its own in-memory counters,
# which is best effort only: counters reset on cold starts and are not shared.
# If Redis errors or times out, requests are allowed and a warning is logged.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The Vercel KV / Upstash marketplace integration sets these instead; both work.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Owner bypass ------------------------------------------------------------------
# Secret that lets the site owner skip rate limits. Use at least 32 random characters;
# tokens shorter than 16 characters are ignored. Generate one with:
#   openssl rand -hex 32
#
# Browser: visit https://<your-domain>/?bypass=<token> once. You are redirected to the
# same page without the token and get a one-year HttpOnly cookie holding a hash of it.
# Visit https://<your-domain>/?bypass=off to remove the cookie. Rotating the token
# invalidates existing cookies.
#
# API / scripts: send the token in a header, for example
#   curl -H "x-ratelimit-bypass: <token>" "https://<your-domain>/api/qr?data=hello"
#
# Bypassed responses carry the header `x-ratelimit-bypass: 1`.
RATE_LIMIT_BYPASS_TOKEN=

# Optional comma-separated IPs that are never limited. IPv6 addresses match their
# whole /64 network, e.g. 203.0.113.7,2001:db8:1234:5678::1
RATE_LIMIT_BYPASS_IPS=
